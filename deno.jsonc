{
    // Root config = Panorama. Mod sources (<mod>/src/) and .shared/ are TypeScript checked
    // against types/panorama.d.ts with plain ES2021 and nothing else: no Deno, no DOM.
    // `deno task bundle` turns each mod's src/main.ts into one panorama/scripts/<mod>.js.
    // .tooling/ is a workspace member with normal Deno settings.
    "workspace": ["./.tooling"],

    "compilerOptions": {
        "lib": ["es2021"],
        "types": ["./types/panorama.d.ts"],
        "strict": false,
        "strictNullChecks": true
    },

    // Mods import shared code as "@shared/chat.ts" etc.; the bundler inlines it.
    "imports": {
        "@shared/": "./.shared/"
    },

    // tools/ is the PowerShell compiler. */panorama/scripts/ is bundler output.
    "exclude": ["tools/", "*/panorama/scripts/"],

    "lint": {
        // types/panorama.d.ts describes engine APIs that return untyped data (`any`).
        "exclude": ["types/"],
        "plugins": ["./.tooling/lint-panorama.ts"],
        "rules": {
            // Panorama throws from lots of native calls; `catch {}` is normal.
            "exclude": ["no-empty"]
        }
    },

    // deno fmt would rewrite `if(` to `if (`; formatting is left to you.
    "fmt": {
        "exclude": ["**/*"]
    },

    "tasks": {
        "lint": {
            "description": "deno lint + Panorama rules (browser globals, semicolons)",
            "command": "deno lint"
        },
        "check": {
            "description": "Type-check mods against types/panorama.d.ts, and the tooling",
            "command": "deno check"
        },
        "verify": {
            "description": "lint + check",
            "command": "deno lint && deno check"
        },
        "bundle": {
            "description": "Bundle <mod>/src/main.ts into <mod>/panorama/scripts/<mod>.js (DEBUG as in source). For the compiler menu; dev and build bundle by themselves. Usage: deno task bundle [mod]",
            "command": "deno run --unstable-bundle --allow-read --allow-write --allow-run=git .tooling/bundle.ts"
        },
        "dev": {
            "description": "Bundle with DEBUG on, build, install into addons, launch Deadlock with -dev -console -condebug, follow the log. Usage: deno task dev [mod] [--all] [--filter <regex>] [-- <launch flags>]",
            "command": "deno run --unstable-bundle --allow-read --allow-write --allow-run=powershell,tasklist,git .tooling/dev.ts",
            "dependencies": ["verify"]
        },
        "log": {
            "description": "Follow Deadlock's console.log, filtered to your mod, UMM and script errors. Usage: deno task log [mod] [--all] [--filter <regex>]",
            "command": "deno run --allow-read --allow-run=powershell,tasklist .tooling/dev.ts --log-only"
        },
        "build": {
            "description": "Release build with DEBUG off, to tools/builds/<mod>.vpk, plus <mod>-<commit>.zip holding it for upload. Usage: deno task build [mod]",
            "command": "deno run --unstable-bundle --allow-read --allow-write --allow-run=powershell,git .tooling/dev.ts --release",
            "dependencies": ["verify"]
        },
        "pull": {
            "description": "Re-export Valve's current layout from pak01_dir.vpk and re-add the mod's script include. Usage: deno task pull [mod] [--check]",
            "command": "deno run --allow-read --allow-write --allow-env=SOURCE2VIEWER_CLI --allow-run .tooling/pull.ts"
        }
    }
}
